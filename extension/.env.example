# Verdict Chrome Extension Environment Configuration

# Verdict Backend API Base URL
VITE_VERDICT_API_BASE_URL=https://api.verdict.example.com

# Verdict Web Application Base URL (Settings / Account / Family Shield)
VITE_VERDICT_WEB_URL=https://verdict.example.com

# Use Mock API Adapter during local development (true/false)
VITE_VERDICT_USE_MOCK=false

# Firebase Configuration (For future website auth & account linking)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
