.env
.env.local
.env.*.local
*.local

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Testing & Coverage
coverage/
.nyc_output/

# Cache
.eslintcache
*.tsbuildinfo
